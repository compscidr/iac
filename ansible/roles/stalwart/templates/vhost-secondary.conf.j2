# {{ ansible_managed }}. nginx-proxy server-level include for {{ item }}.
# The web admin is tailnet-only (Stalwart's 8081 listener); Stalwart refuses it here too.
location /admin { return 403; }
# One webmail origin, so Bulwark and JMAP stay same-origin under STALWART_PUBLIC_URL.
location /webmail { return 302 https://{{ stalwart_hostname }}/webmail/; }
