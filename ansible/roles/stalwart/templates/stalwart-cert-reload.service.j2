# {{ ansible_managed }}
# Makes Stalwart serve a renewed certificate. Output is discarded (stalwart-cli may echo
# secrets); a failure shows as this unit failing: `systemctl status stalwart-cert-reload`.
[Unit]
Description=Reload Stalwart's TLS certificates
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
StandardOutput=null
StandardError=null
# The renewed files first: the container cannot read acme-companion's key (0600 root).
{% for c in stalwart_cert_copies %}
ExecStartPre=/usr/bin/install -o {{ stalwart_uid }} -g {{ stalwart_uid }} -m 0600 {{ c.src }} {{ c.dest }}
{% endfor %}
ExecStart={{ stalwart_cli_docker }} create Action/ReloadTlsCertificates
