[Unit]
Description=rustd.xyz nightly postgres dump, shipped to the nas
After=docker.service
Requires=docker.service

# A push that lands inside a nas-side ugacl reset window (UGOS drops the
# svcbackup entry; the backup_nas role's 15-min root cron re-adds it) gets
# "Permission denied (13)" from the daemon and lost the whole night (2026-10-02,
# 2026-10-09). Retry a few times, spaced wider than that cron, instead.
# Bounded: 4 starts in 3h, then stay failed and let the freshness check alert.
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart={{ rustd_xyz_base_path }}/rustd-db-backup.sh
Restart=on-failure
RestartSec=20min
