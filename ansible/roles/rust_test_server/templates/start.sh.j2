#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Bare-metal launcher for the rustd.xyz test server.
#
# Deliberately has NO supervision loop. The containerised servers exit and are
# restarted by docker's policy; this one, run in the foreground, simply exits — which
# is exactly the case compscidr/rustd.xyz#340 needs to observe. Do not add a
# `while true` here without reading that issue first: it would silently answer the
# question this server exists to ask.

set -euo pipefail

SEED_FILE="{{ rust_test_server_data_dir }}/seed.env"
ENV_FILE="{{ rust_test_server_data_dir }}/rust.env"

# Fail loudly rather than booting with an empty seed. Rust picks its own seed when
# +server.seed is empty, so the running map would silently stop matching what
# seed.env — and the panel — believe is running. A server that refuses to start is a
# far cheaper failure than one running a map nobody can identify.
if [ ! -r "${SEED_FILE}" ]; then
  echo "FATAL: ${SEED_FILE} is missing or unreadable" >&2
  exit 1
fi

set -o allexport
# rust.env first, as the containerised servers read it: rustd.xyz rewrites it in place
# (the map URL a custom or combined-map wipe arms, the world size, the hostname and
# description), and this script reads whatever it says at boot. Optional: the role creates
# it empty, and an empty file changes nothing below. Before 2026-10-15 this rig never read
# it, so a wipe that armed a combined map came back on the old procedural one and nothing
# noticed (compscidr/rustd.xyz#913).
if [ -r "${ENV_FILE}" ]; then
  # shellcheck source=/dev/null
  source "${ENV_FILE}"
fi
# Split out so a wipe can rotate the seed without touching this script. Second, so a
# rotated seed always wins over a stale value in rust.env.
# shellcheck source=/dev/null
source "${SEED_FILE}"
set +o allexport

if [ -z "${RUST_SERVER_SEED:-}" ]; then
  echo "FATAL: ${SEED_FILE} did not set RUST_SERVER_SEED" >&2
  exit 1
fi

# Update on every start, not just on every play. Rust clients update themselves, so a
# server that only updates when the playbook runs falls behind at the next game update
# and refuses every client with "wrong connection protocol: server update required" —
# it sat on a 2026-08-18 build until 2026-09-30 that way. With Restart=always, an RCON
# `restart 0` is now also how to pick up a new build.
#
# No `validate` (the play keeps it): it rehashes the whole install, minutes per boot for
# nothing. A failed update (Steam down, no network) must not keep the server down, so it
# warns and boots the build already on disk.
#
# Bounded, because a stalled steamcmd is worse than a failed one: the unit is
# Type=simple, so systemd reports it active the moment this script starts and never
# notices that the exec below is not reached. A hung update would leave a "running"
# server that is not running. The bound is generous — a full game update is several GB —
# and steamcmd stages a download before committing it, so a kill mid-download leaves the
# installed build to boot.
if ! timeout --kill-after=30s {{ rust_test_server_update_timeout }} \
  {{ rust_test_server_steamcmd_dir }}/steamcmd.sh \
  +force_install_dir {{ rust_test_server_root }} \
  +login anonymous \
  +app_update 258550 \
  +quit; then
  echo "WARNING: steamcmd update failed or timed out; starting the installed build" >&2
fi

# The map, chosen the way the container image's /app/start.sh chooses it (read from the
# rust-build container on the cube, 2026-10-15): a level URL boots that file and takes
# neither size nor seed — the file has its own size; otherwise the world is generated
# from the seed at the size rust.env names, or this rig's small default.
if [ -n "${RUST_SERVER_LEVELURL:-}" ]; then
  MAP_ARGS=(+server.levelurl "${RUST_SERVER_LEVELURL}")
  echo "Using custom map: ${RUST_SERVER_LEVELURL}"
else
  MAP_ARGS=(+server.worldsize "${RUST_SERVER_WORLDSIZE:-{{ rust_test_server_worldsize }}}" +server.seed "${RUST_SERVER_SEED}")
fi

# Only when the panel has set one, as the image does.
BANNER_ARGS=()
if [ -n "${RUST_SERVER_BANNER_URL:-}" ]; then
  BANNER_ARGS=(+server.headerimage "${RUST_SERVER_BANNER_URL}")
fi

exec {{ rust_test_server_root }}/RustDedicated -batchmode -nographics \
  +server.identity "{{ rust_test_server_identity }}" \
  +server.hostname "${RUST_SERVER_NAME:-{{ rust_test_server_name }}}" \
  +server.description "${RUST_SERVER_DESCRIPTION:-{{ rust_test_server_description }}}" \
  "${BANNER_ARGS[@]}" \
  +server.port {{ rust_test_server_port }} \
  +server.queryport {{ rust_test_server_query_port }} \
  +server.maxplayers {{ rust_test_server_maxplayers }} \
  "${MAP_ARGS[@]}" \
  +server.saveinterval 300 \
  +app.port {{ rust_test_server_app_port }} \
  +rcon.port {{ rust_test_server_rcon_port }} \
  +rcon.password "{{ rust_test_server_rcon_password }}" \
  +rcon.web 1
