# {{ ansible_managed }}
# Hermes Agent settings. Ansible-owned: hermes is expected to keep its
# runtime state in other files under ~/.hermes. If a deployed hermes
# version is observed rewriting this file, switch the template task to
# `force: false` and manage settings via `hermes config set` instead.

# Primary model: ollama on ubuntu-beast over Tailscale.
model:
  default: "{{ hermes_ollama_model }}"
  provider: ollama-beast

# Both are keyless local servers, but hermes warns on every call it
# routes to a provider whose key it cannot resolve ("will be sent with
# placeholder no-key-required") — so point them at a placeholder env var
# instead of leaving the field unset. Neither server checks the value.
providers:
  ollama-beast:
    api: "{{ hermes_ollama_base_url }}"
    transport: chat_completions
    default_model: "{{ hermes_ollama_model }}"
    key_env: LOCAL_MODEL_API_KEY
  exo-beast:
    api: "{{ hermes_exo_base_url }}"
    transport: chat_completions
    default_model: "{{ hermes_exo_model }}"
    key_env: LOCAL_MODEL_API_KEY

# Tried in order when the primary fails (beast off / model unloaded /
# rate-limited). Cloud rungs render only once their key is in .env.
fallback_providers:
  - provider: exo-beast
    model: "{{ hermes_exo_model }}"
{% if hermes_anthropic_api_key %}
  - provider: anthropic
    model: "{{ hermes_anthropic_model }}"
{% endif %}
{% if hermes_kimi_api_key %}
  - provider: kimi
    model: "{{ hermes_kimi_model }}"
{% endif %}
{% if hermes_openai_api_key %}
  - provider: openai
    model: "{{ hermes_openai_model }}"
{% endif %}
{% if hermes_xai_api_key %}
  - provider: xai
    model: "{{ hermes_xai_model }}"
{% endif %}
{% if hermes_gemini_api_key %}
  - provider: gemini
    model: "{{ hermes_gemini_model }}"
{% endif %}

{% if hermes_ollama_context_window %}
# Tell hermes the window ollama actually serves. Left to itself it
# detects the model's native size (262144) and caches it, then sizes
# ratio-based compaction against a window four times the real one.
model_overrides:
  "{{ hermes_ollama_provider_id }}":
    "{{ hermes_ollama_model }}":
      context_window: {{ hermes_ollama_context_window }}
{% endif %}

{% if hermes_tool_output_max_bytes %}
# Cap a single tool result. The default 50,000 chars is 12-15K tokens —
# a fifth of a 64K window for one call.
tool_output:
  max_bytes: {{ hermes_tool_output_max_bytes }}
{% endif %}
{% if hermes_web_extract_char_limit %}
web:
  # Full text is still cached on disk; this only caps what enters context.
  extract_char_limit: {{ hermes_web_extract_char_limit }}
{% endif %}
{% if hermes_tool_hard_stop_enabled %}
tool_loop_guardrails:
  # Stop repeated non-progressing calls rather than only warning: each
  # repeat re-pays full tool output into a window that is already tight.
  hard_stop_enabled: true
{% endif %}

{% if hermes_compression_threshold_tokens or hermes_compression_tail_mode %}
compression:
{% if hermes_compression_threshold_tokens %}
  # Absolute trigger, not just the ratio — the ratio floors at 0.75 of a
  # 64K window, which fires too late to leave the summariser room.
  threshold_tokens: {{ hermes_compression_threshold_tokens }}
{% endif %}
{% if hermes_compression_tail_mode %}
  tail_mode: "{{ hermes_compression_tail_mode }}"
{% endif %}
{% endif %}

{% if hermes_ollama_reasoning_effort or hermes_run_budget_seconds %}
agent:
{% if hermes_run_budget_seconds %}
  run_budget_seconds: {{ hermes_run_budget_seconds }}
{% endif %}
  # Per-model thinking level; keyed by model name, so it applies only to
  # the local model and leaves every other provider on its default.
  reasoning_overrides:
    "{{ hermes_ollama_model }}": "{{ hermes_ollama_reasoning_effort }}"
{% endif %}

discord:
  # Mention required in general; the #hermes-agent channel is in
  # DISCORD_FREE_RESPONSE_CHANNELS (.env) so it needs no mention.
  require_mention: true
  auto_thread: true

# Per-user session isolation in group channels.
group_sessions_per_user: true
