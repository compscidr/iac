# {{ ansible_managed }}
[Unit]
Description=Hermes Agent gateway (Discord)

[Service]
# Load secrets explicitly rather than relying on hermes to source its
# own ~/.hermes/.env; a missing file fails the unit loudly instead of
# starting an unauthenticated gateway.
EnvironmentFile={{ hermes_config_dir }}/.env
ExecStart={{ hermes_bin }} gateway
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
