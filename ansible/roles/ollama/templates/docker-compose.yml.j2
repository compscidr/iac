---
# Ollama Docker Compose configuration
# Managed by Ansible - do not edit directly

services:
  ollama:
    image: {{ ollama_image }}
    container_name: {{ ollama_container_name }}
    restart: {{ ollama_restart_policy }}
    ports:
      - "{{ ollama_bind_address }}:{{ ollama_port }}:11434"
    volumes:
      - ollama_data:/root/.ollama
{% if ollama_gpu_enabled %}
    # CDI device injection, not the legacy nvidia runtime hook.
    #
    # The hook configures the device cgroup out of band, so any
    # `systemctl daemon-reload` on the host makes runc re-sync this
    # container's device allowlist and silently drop the GPUs. It fails
    # quietly: ollama's parent process cached its GPU inventory at
    # startup, so it keeps reporting both cards and planning GPU loads
    # while every llama-server child gets "no CUDA-capable device is
    # detected" and falls back to CPU. A 19GB model then runs on the
    # 5900X and nothing in ollama's own logs says anything is wrong.
    #
    # Any daemon-reload triggers it, including apt upgrades that ship a
    # unit file -- this is not hypothetical maintenance-window damage.
    # CDI declares the devices in the OCI spec instead, where runc knows
    # to re-apply them across a reload.
    #
    # Requires Docker >= 25 with CDI enabled (29.x defaults to on) and
    # specs under /var/run/cdi, kept current by nvidia-cdi-refresh.service.
    devices:
      - nvidia.com/gpu=all
{% endif %}
    environment:
      - OLLAMA_HOST=0.0.0.0
{% if ollama_num_gpu != -1 %}
      - OLLAMA_NUM_GPU={{ ollama_num_gpu }}
{% endif %}
{% if ollama_flash_attention %}
      # Flash attention + a quantized KV cache shrink the per-token
      # attention memory, which is what decides whether a long-context
      # model fits in VRAM or gets partially pushed onto the CPU.
      - OLLAMA_FLASH_ATTENTION=1
      - OLLAMA_KV_CACHE_TYPE={{ ollama_kv_cache_type }}
{% endif %}
      # Allow large models to use system RAM for layer offloading
      # With 128GB RAM, 70B+ models run well with partial GPU acceleration
{% if ollama_tailscale_only %}
      # Note: Firewall rules should restrict to Tailscale IPs
      # This is informational - actual restriction via iptables/ufw
{% endif %}

volumes:
  ollama_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ ollama_data_path }}/data
