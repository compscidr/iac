{
  "_comment": "Managed by ansible (factorio_game role) - do not edit by hand.",
  "name": "{{ factorio_game_server_name }}",
  "description": "{{ factorio_game_description }}",
  "tags": [],
  "max_players": {{ factorio_game_max_players }},
  "visibility": {
    "public": {{ factorio_game_public | string | lower }},
    "lan": true
  },
  "username": "{{ factorio_game_username }}",
  "token": "{{ factorio_game_token }}",
  "game_password": "",
  "require_user_verification": {{ factorio_game_require_user_verification | string | lower }},
  "max_upload_in_kilobytes_per_second": 0,
  "max_upload_slots": 5,
  "minimum_latency_in_ticks": 0,
  "ignore_player_limit_for_returning_players": false,
  "allow_commands": "admins-only",
  "autosave_interval": 10,
  "autosave_slots": 5,
  "afk_autokick_interval": 0,
  "auto_pause": true,
  "only_admins_can_pause_the_game": true,
  "autosave_only_on_server": true,
  "non_blocking_saving": true
}
