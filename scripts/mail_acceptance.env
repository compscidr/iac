# 1Password references for scripts/mail_acceptance.py. References only, never values.
#   op run --env-file scripts/mail_acceptance.env -- python3 scripts/mail_acceptance.py --mode staged
# The variable name is MAIL_PW_ + the address upper-cased, with @ and . as _.
MAIL_PW_JASON_JASONERNST_COM=op://Infrastructure/mail.jasonernst.com - jason/password
MAIL_PW_KAI_JASONERNST_COM=op://Infrastructure/mail.jasonernst.com - kai/password
MAIL_PW_JASON_SAIR_RUN=op://Infrastructure/mail.sair.run - jason/password
MAIL_PW_JASON_RUSTD_XYZ=op://Infrastructure/mail.rustd.xyz - jason/password
MAIL_PW_JASON_DARKSEARCH_XYZ=op://Infrastructure/mail.darksearch.xyz - jason/password
MAIL_PW_NOREPLY_JASONERNST_COM=op://Infrastructure/SMTP_USER - goblog/password
MAIL_PW_NOREPLY_SAIR_RUN=op://Infrastructure/SMTP_USER - sair/password
MAIL_PW_NOREPLY_RUSTD_XYZ=op://Infrastructure/SMTP_USER - rustd/password
# Uncomment once the `Stalwart Admin` item exists (an unresolvable reference makes `op run`
# fail for the whole file). admin_public_blocked FAILs while this is unset.
# STALWART_ADMIN_PASSWORD=op://Infrastructure/Stalwart Admin/password
