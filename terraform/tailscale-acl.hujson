// Example/default ACLs for unrestricted connections.
{
	// Declare static groups of users. Use autogroups for all users or users with a specific role.
	// "groups": {
	//      "group:example": ["alice@example.com", "bob@example.com"],
	// },

	// Define the tags which can be applied to devices and by which users.
	// "tagOwners": {
	//      "tag:example": ["autogroup:admin"],
	// },
	"tagOwners": {
		"tag:agent":      ["ernstjason1@gmail.com"],
		"tag:llm-server": ["ernstjason1@gmail.com"],
	},

	// Define grants that govern access for users, groups, autogroups, tags,
	// Tailscale IP addresses, and subnet ranges.
	"grants": [
		// Your member devices - full access everywhere including tagged machines
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},

		// Agent (hermes) - only Ollama + exo, and only on machines
		// explicitly tagged as model servers.
		//
		// Destination is a tag rather than a tailnet IP because IPs go
		// stale silently: this rule named 100.79.121.111 while
		// ubuntu-beast had moved to 100.87.35.11, and every one of the
		// agent's model calls was dropped with no signal anywhere
		// (found during the 2026-08 hermes cutover). Tags survive a
		// node rebuild. It is also narrower than targeting the *user*,
		// which would expose these ports on every machine Jason is
		// signed into — hermes takes instructions from Discord, and
		// ollama's API is unauthenticated and can delete or pull
		// models, so the reachable surface is kept to machines that
		// deliberately serve models.
		//
		// To enroll a model server (ubuntu-cube when it starts serving):
		//   sudo tailscale up --advertise-tags=tag:llm-server --ssh \
		//        --hostname=<name>
		// (`tailscale up` demands every non-default flag be restated.)
		//
		// Note these can only ever be tailnet-internal selectors: DNS
		// names (home.jasonernst.com and friends) are never resolved by
		// the policy file, and tailnet traffic is not addressed to a
		// device's public IP.
		//
		// Both services are HTTP-over-TCP; explicit `tcp:` prefix
		// avoids any protocol-default ambiguity in the grants syntax.
		{
			"src": ["tag:agent"],
			"dst": ["tag:llm-server"],
			"ip":  ["tcp:11434", "tcp:52415"],
		},
	],

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Allow SSH to tagged machines from members. tag:llm-server is
		// listed explicitly because a tagged device is owned by the
		// tailnet, not by Jason — it stops matching `autogroup:self`
		// above, so without this line tagging ubuntu-beast would cut
		// off tailscale-ssh to it from the other machines.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["tag:agent", "tag:llm-server"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
	"nodeAttrs": [
		{
			// Funnel policy, which lets tailnet members control Funnel
			// for their own devices.
			// Learn more at https://tailscale.com/kb/1223/tailscale-funnel/
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],
}
