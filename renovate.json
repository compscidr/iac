{
  "extends": [
    "config:base"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track aaddrick/claude-desktop-debian releases for the dev_gui_claude_desktop_tag pin in dev_gui role",
      "fileMatch": [
        "^ansible/roles/dev_gui/defaults/main\\.yml$"
      ],
      "matchStrings": [
        "dev_gui_claude_desktop_tag:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aaddrick/claude-desktop-debian",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track ansible and ansible-lint pins in the verify workflow",
      "fileMatch": [
        "^\\.github/workflows/verify\\.yml$"
      ],
      "matchStrings": [
        "(?<depName>ansible|ansible-lint)==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
