{
  "extends": [
    "config:recommended",
    "github>compscidr/renovate-config:sair"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track zed-industries/zed releases for the zed_version pin in the zed role",
      "managerFilePatterns": [
        "/^ansible/roles/zed/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "zed_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zed-industries/zed",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track ansible and ansible-lint pins in the verify workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/verify\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>ansible|ansible-lint)==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "A sair bump is the signal that the host proxy/device-source is behind. Keep the PR open until sair.yml has been run against the host, then merge it by hand.",
      "matchDepNames": [
        "compscidr/sair"
      ],
      "automerge": false
    }
  ]
}
