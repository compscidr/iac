{
  "extends": [
    "config:recommended",
    "github>compscidr/renovate-config:sair"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track aaddrick/claude-desktop-debian releases for the dev_gui_claude_desktop_tag pin in dev_gui role",
      "managerFilePatterns": [
        "/^ansible/roles/dev_gui/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "dev_gui_claude_desktop_tag:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aaddrick/claude-desktop-debian",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Track ansible and ansible-lint pins in the verify workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/verify\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>ansible|ansible-lint)==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "A sair bump is the signal that the host proxy/device-source is behind. Keep the PR open until sair.yml has been run against the host, then merge it by hand.",
      "matchDepNames": [
        "compscidr/sair"
      ],
      "automerge": false
    }
  ]
}
