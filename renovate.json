{
  "extends": [
    "config:recommended",
    "github>compscidr/renovate-config:sair"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track zed-industries/zed releases for the zed_version pin in the zed role",
      "managerFilePatterns": [
        "/^ansible/roles/zed/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "zed_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zed-industries/zed",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track stablyai/orca releases for the dev_gui_orca_version pin in the dev_gui role",
      "managerFilePatterns": [
        "/^ansible/roles/dev_gui/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "dev_gui_orca_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "stablyai/orca",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track anomalyco/opencode releases for the opencode_version pin in the opencode role",
      "managerFilePatterns": [
        "/^ansible/roles/opencode/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "opencode_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anomalyco/opencode",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track hacs/integration releases for the home_assistant_hacs_version pin in the home_assistant role",
      "managerFilePatterns": [
        "/^ansible/roles/home_assistant/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "home_assistant_hacs_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hacs/integration"
    },
    {
      "customType": "regex",
      "description": "Track aws/aws-cli v2 tags for the dev_awscli_version pin in the dev role",
      "managerFilePatterns": [
        "/^ansible/roles/dev/vars/main\\.yml$/"
      ],
      "matchStrings": [
        "dev_awscli_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "aws/aws-cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track ansible and ansible-lint pins in the verify workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/verify\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>ansible|ansible-lint)==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Track ipfs_indexer release images for the ipfs_indexer_version pin in the ipfs_indexer role (the image, not the git tag, so the PR only opens once the image is pullable)",
      "managerFilePatterns": [
        "/^ansible/roles/ipfs_indexer/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "ipfs_indexer_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/compscidr/ipfs_indexer"
    },
    {
      "customType": "regex",
      "description": "Track compscidr/sair-orchestrator tags for the orchestrator and portal image pins; merging does not deploy, re-run projects.yml",
      "managerFilePatterns": [
        "/^ansible/roles/sair_(orchestrator|portal)/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "sair_(?:orchestrator|portal)_version:\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "compscidr/sair-orchestrator",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "A sair bump is the signal that the host proxy/device-source is behind. Keep the PR open until sair.yml has been run against the host, then merge it by hand.",
      "matchDepNames": [
        "compscidr/sair"
      ],
      "automerge": false
    },
    {
      "description": "Merging the ipfs_indexer pin doesn't deploy it. Keep the PR open until the ipfs-indexer tag of cube.yml has been run, then merge it by hand.",
      "matchDepNames": [
        "ghcr.io/compscidr/ipfs_indexer"
      ],
      "automerge": false
    },
    {
      "description": "ansible-core patches dataclasses._is_type, which Python 3.15 removed (see #787). Lift once an ansible release supports 3.15.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
